[Unit]
Description=Nightly arXiv digest + ticked-paper ingest into ~/Research (pushes to Forgejo)
Wants=network-online.target
After=network-online.target
# Retry after a usage limit (exit 1): every 75 min, at most 5 starts a day — spans a 5 h limit
# window, and a 6 h timeout can't loop because the window is a full day.
StartLimitIntervalSec=24h
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=%h/.local/bin/research-digest-cron
TimeoutStartSec=6h
Restart=on-failure
RestartSec=75min
# Exit 2 = needs Kiyam (git conflict / unpushed work): fail visibly, don't retry.
RestartPreventExitStatus=2
