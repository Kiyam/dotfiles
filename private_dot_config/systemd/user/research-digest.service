[Unit]
Description=Nightly arXiv digest + ticked-paper ingest into ~/Research (pushes to Forgejo)
Wants=network-online.target
After=network-online.target
# Retry after a usage limit (exit 1) every 75 min until the run finishes; 20 > 24h/75min, so the
# start limit never blocks a retry (weekend runs keep going across limit resets).
StartLimitIntervalSec=24h
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=%h/.local/bin/research-digest-cron
TimeoutStartSec=6h
Restart=on-failure
RestartSec=75min
# Exit 2 = needs Kiyam (git conflict / unpushed work): fail visibly, don't retry.
RestartPreventExitStatus=2
