{
  "model": "opus",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/agents-pane"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rm_confirmation.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"m='{{ .chezmoi.homeDir }}/.claude/shared-memory'; GIT_SSH_COMMAND='ssh -o ConnectTimeout=3 -o BatchMode=yes' git -C \"$m\" pull -q --ff-only >/dev/null 2>&1; [ -f \"$m/index.md\" ] && { echo \"Shared memory index ($m, files relative to it):\"; cat \"$m/index.md\"; }; true","timeout":8}{{ if stat (joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh") }},{"type":"command","command":"bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session","timeout":10}{{ end }}]}]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "adobe-for-creativity@claude-plugins-official": false,
    "data@synced": false,
    "marketing@synced": false,
    "design@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "pdf-viewer@synced": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline-combined.sh"
  },
  "skillOverrides": {
    "jax-review": "off",
    "paper-summariser": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "permissions": {
    "defaultMode": "auto"
  }{{- if eq .chezmoi.hostname "prometheus" }},
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable here (no remotes on this repo); assume private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Not queryable here (no remotes, default branch unknown)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo /home/kiyam/cosmology/spherical_inference only (no remotes configured, no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /home/kiyam/cosmology/spherical_inference (this repo has no remotes configured; treat as local-only, assume private)",
      "**Org-specific CLIs**: None configured — chezmoi, rsync, ssh-keygen, ssh-add, hostname, hunk seen in this project's usage are general-purpose developer tools, not org-specific",
      "**Separate personal memory sync**: routine under ~/.claude/shared-memory (private repo kiyam/claude-memory on ssh://forgejo.olympus.kiyam.co:222) is user-configured cross-machine memory sync, not part of this project's trust scope"
    ]
  }{{- end }}
}
