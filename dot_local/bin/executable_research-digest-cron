#!/bin/sh
# Nightly on Prometheus (systemd user timer, 23:00 and 04:00 Paris): process ticked papers and the
# Zotero Ingest inbox, one per Claude session, and write the day's arXiv digest once listings are out
# (after 03:00 Paris). Starting at 23:00 gives two 5-hour usage windows before the 09:00 cutoff.
# Pushes use the repo-only deploy key.
# Exit 1 = usage limit (systemd retries later); exit 2 = needs Kiyam (git conflict or unpushed
# work; systemd does not retry). Logs: journalctl --user -u research-digest
export TZ=Europe/Paris                # all clock checks (and the digest's date) in Kiyam's time
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export GIT_SSH_COMMAND="ssh -i $HOME/.ssh/research_deploy -o IdentitiesOnly=yes -o BatchMode=yes"
cd "$HOME/Research" || exit 2
TOOLS="Bash,Read,Write,Edit,Glob,Grep,WebFetch,mcp__zotero,mcp__mcp-ads-arxiv"
MAX_TICKS=40                         # ponytail: fixed weekday cap (ticks + inbox together)
[ "$(date +%u)" -ge 6 ] && MAX_TICKS=100000  # weekends: drain the backlog, retrying after each usage limit
SESSION_TIMEOUT=${SESSION_TIMEOUT:-45m}  # one hung session must not eat the night

# Weekdays 09:00–23:00 Paris the day's usage belongs to Kiyam: no new sessions, no retries; a
# session already running finishes (≤ SESSION_TIMEOUT). Leftovers carry to the next night.
# DAYTIME_OK=1 overrides for a manual run.
daytime() { [ -z "$DAYTIME_OK" ] && [ "$(date +%u)" -le 5 ] && [ "$(date +%H)" -ge 9 ] && [ "$(date +%H)" -lt 23 ]; }
# arXiv mails Mon–Fri, posted ~02:00 Paris; write the digest once per day after 03:00. The skill
# also backfills weekdays missed in the last 5 (oldest first, today last), so "today exists" = done.
digest() {
    [ "$(date +%u)" -le 5 ] && [ "$(date +%H)" -ge 3 ] && [ "$(date +%H)" -lt 23 ] && [ ! -e "daily/digest_$(date +%F).md" ] || return 0
    run "/research-digest" || exit 1
}

run() {  # $1 = prompt
    out=$(printf '%s\n' "$1" | timeout "$SESSION_TIMEOUT" claude -p --allowedTools "$TOOLS" 2>&1); rc=$?
    printf '%s\n' "$out"
    [ "$rc" -eq 124 ] && echo "session timed out after $SESSION_TIMEOUT"
    case "$out" in *"hit your session limit"*|*"usage limit"*)
        daytime && { echo "usage limit: weekday daytime, no retry"; exit 0; }
        echo "usage limit: will retry"; exit 1;; esac
    return $rc
}
pull() {  # commit leftovers of a killed session, pull; on failure leave the repo clean and stop
    if [ -n "$(git status --porcelain wiki daily)" ]; then
        git add -A wiki daily && git commit -qm "wip: interrupted session (lint will tidy)"
    fi
    git pull -q --rebase --autostash && return 0
    git rebase --abort 2>/dev/null
    echo "git pull failed (conflict?) — resolve in ~/Research on Prometheus, then: systemctl --user start research-digest (weekday daytime: DAYTIME_OK=1 research-digest-cron)"
    exit 2
}
next_tick() { grep -nE '^- \[x\] (ingest|to read)[[:space:]]*$' daily/*.md 2>/dev/null | head -1; }
zotero_ingest() {  # prints "<count> <oldest key>" for unblocked Ingest items; "-1" if Zotero can't be reached
    resp=$( . "$HOME/.config/research/secrets.env"
            printf 'header = "Zotero-API-Key: %s"\n' "$ZOTERO_API_KEY" |  # key via stdin, not argv
            curl -s -i -K - "https://api.zotero.org/users/$ZOTERO_LIBRARY_ID/collections/ZVZ3TU8S/items/top?limit=1&format=keys&sort=dateAdded&direction=asc&tag=-needs-kiyam" ) ||
        { echo -1; return; }
    printf '%s\n' "$resp" | tr -d '\r' | awk '
        NR==1 {code=$2} /^$/ {body=1; next}
        tolower($1)=="total-results:" {n=$2}
        body && NF && !k {k=$1}
        END {if (code==401 || code==403) print "rejected"; else if (code!=200) print -1; else print (n?n:0), k}'
}

daytime && { echo "weekday daytime (09:00–23:00 Paris): not starting (DAYTIME_OK=1 to override)"; exit 0; }
pull
digest

i=0; last=""
while [ "$i" -lt "$MAX_TICKS" ]; do
    daytime && { echo "09:00 Paris reached: stopping, the rest carries to tonight"; break; }
    pull; digest
    t=$(next_tick)
    [ -z "$t" ] && { echo "no pending ticks"; break; }
    [ "$t" = "$last" ] && { echo "tick not marked done or blocked: $t — stopping to avoid a loop"; break; }
    last=$t
    echo "--- tick $((i+1)): $t"
    run "/research-ingest daily --one"
    i=$((i+1))
done

last=""
while [ "$i" -lt "$MAX_TICKS" ]; do
    daytime && { echo "09:00 Paris reached: stopping, the rest carries to tonight"; break; }
    digest
    set -- $(zotero_ingest)
    case "$1" in
        rejected) echo "Zotero rejected the API key — check ~/.config/research/secrets.env"; exit 2;;
        -1) echo "Zotero unreachable — skipping the Ingest inbox tonight"; break;;
        0) echo "Ingest inbox empty"; break;;
    esac
    [ "$2" = "$last" ] && { echo "Ingest item $2 not filed or blocked — stopping to avoid a loop"; break; }
    last=$2
    echo "--- inbox $((i+1)): $1 in Ingest, oldest $2"
    run "/research-ingest inbox --one $2"  # same item the loop guard tracks
    i=$((i+1))
done

pull; git push -q 2>/dev/null
if git status -sb | head -1 | grep -q ahead; then
    echo "unpushed commits left in ~/Research on Prometheus — check git status"; exit 2
fi
