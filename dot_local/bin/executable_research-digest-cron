#!/bin/sh
# Daily arXiv digest (systemd user timer on Prometheus): runs /research-digest, which
# commits and pushes to ~/Research with the repo-only deploy key.
# Logs: journalctl --user -u research-digest
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export GIT_SSH_COMMAND="ssh -i $HOME/.ssh/research_deploy -o IdentitiesOnly=yes -o BatchMode=yes"
cd "$HOME/Research" || exit 1
exec claude -p --allowedTools "Bash,Read,Write,Edit,Glob,Grep,WebFetch" <<EOF
/research-digest
EOF
